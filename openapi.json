{
  "openapi": "3.1.0",
  "info": {
    "title": "User Authentication API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3333",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/joke": {
      "get": {
        "summary": "Get a Random Joke",
        "responses": {
          "200": {
            "description": "A random joke",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "joke": {
                      "type": "string",
                      "description": "A humorous text.",
                      "example": "Why don’t programmers like nature? It has too many bugs."
                    }
                  },
                  "required": [
                    "joke"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a New Joke",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "joke": {
                    "type": "string",
                    "description": "A humorous text.",
                    "example": "Why don’t programmers like nature? It has too many bugs."
                  }
                },
                "required": [
                  "joke"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Joke added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "joke": {
                      "type": "string",
                      "description": "A humorous text.",
                      "example": "Why don’t programmers like nature? It has too many bugs."
                    }
                  },
                  "required": [
                    "message",
                    "joke"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid joke format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/fortune": {
      "get": {
        "summary": "Get a Fortune Cookie Message",
        "responses": {
          "200": {
            "description": "A random fortune cookie message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fortune": {
                      "type": "string",
                      "description": "A random fortune message.",
                      "example": "Your next coffee will be the best one yet."
                    }
                  },
                  "required": [
                    "fortune"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/mood": {
      "get": {
        "summary": "Get Current Mood",
        "responses": {
          "200": {
            "description": "Current mood of the API",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mood": {
                      "type": "string",
                      "description": "The current mood of the API.",
                      "example": "🤖 Debugging mode"
                    }
                  },
                  "required": [
                    "mood"
                  ]
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update Mood",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mood": {
                    "type": "string",
                    "description": "The current mood of the API.",
                    "example": "🤖 Debugging mode"
                  }
                },
                "required": [
                  "mood"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mood updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "mood": {
                      "type": "string",
                      "description": "The current mood of the API.",
                      "example": "🤖 Debugging mode"
                    }
                  },
                  "required": [
                    "message",
                    "mood"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid mood format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}